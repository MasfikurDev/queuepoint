@baseUrl = http://localhost:3000

###############################################################################
# VARIABLES & HELPERS (fakerjs)
###############################################################################

{{
  const { faker } = require('@faker-js/faker');

  // Generate random organization name
  const organizationName = faker.company.name();

  // Generate random queue/service name
  const queueName = faker.helpers.arrayElement([
    'Emergency', 'Pediatrics', 'Radiology', 'Cardiology', 'Neurology', 
    'Orthopedics', 'Dermatology', 'Oncology', 'Gynecology', 'Urology',
    'Ophthalmology', 'Dental', 'Pharmacy', 'Laboratory', 'Physical Therapy'
  ]) + ' ' + faker.helpers.arrayElement([
    'Intake', 'Check-in', 'Waitlist', 'Priority Queue', 'Reception',
    'Consultation', 'Triage', 'Registration', 'Screening', 'Follow-up'
  ]);

  // Generate random consumer name
  const consumerName = faker.person.fullName();

  // Generate random phone number
  const consumerPhone = faker.phone.number();

  function createFakeUser(){
    let firstName = faker.person.firstName();
    let lastName = faker.person.lastName();
    let name = firstName + " "+ lastName;
    let phone = faker.phone.number();
    let email = faker.internet.exampleEmail({firstName,lastName}).toLowerCase();
    return {
        name,phone,email
    };
  }

  function createFakeConsumer(){
    let firstName = faker.person.firstName();
    let lastName = faker.person.lastName();
    let name = firstName + " "+ lastName;
    let phone = faker.phone.number();
    let email = faker.internet.exampleEmail({firstName,lastName}).toLowerCase();
    return {
        name,phone,email
    };
  }

  exports.user = createFakeUser();
  exports.organizationName = organizationName;
  exports.queueName = queueName;
  exports.consumerName = consumerName;
  exports.consumerPhone = consumerPhone;
}}


### Create User
# @name createUser
POST {{baseUrl}}/users
Content-Type: application/json
{
  "name": "{{user.name}}",
  "phone": "{{user.phone}}",
  "email": "{{user.email}}",
  "password": "1234"
}

> {%
  if (!response.body.id) {
    throw new Error("User id missing");
  }
  client.global.set("userId", response.body.id);
%}

### Get User by ID
# @name getUserById
GET {{baseUrl}}/users/{{userId}}

### List All Users
# @name listUsers
GET {{baseUrl}}/users

> {%
  if (!Array.isArray(response.body)) {
    throw new Error("Expected array of users");
  }
%}

###############################################################################
# ORGANIZATIONS
###############################################################################

### Create a new Organization
# @name createOrganization
POST {{baseUrl}}/organizations
Content-Type: application/json

{
  "userId" : "{{userId}}",
  "name": "{{organizationName}}",
  "type": "business"
}

> {%
  if (!response.body.id) {
    throw new Error("Organization id missing");
  }
  client.global.set("organizationId", response.body.id);
%}

### Get Organization by ID
# @name getOrganizationById
GET {{baseUrl}}/organizations/{{organizationId}}

###############################################################################
# QUEUES
###############################################################################

### Create a new Queue
# @name createQueue
POST {{baseUrl}}/queues
Content-Type: application/json

{
  "organizationId": "{{organizationId}}",
  "name": "{{queueName}}"
}

> {%
  if (!response.body.id) {
    throw new Error("Queue id missing");
  }
  client.global.set("queueId", response.body.id);
%}

### Get Queue by ID
# @name getQueueById
GET {{baseUrl}}/queues/{{queueId}}

### List All Queues
# @name listQueues
GET {{baseUrl}}/queues
> {%
  if (!Array.isArray(response.body)) {
    throw new Error("Expected array of queues");
  }
%}
###############################################################################
# CONSUMERS (QUEUE-SCOPED)
###############################################################################

### Create WALK-IN Consumer (Temporary)
# @name createWalkInConsumer
POST {{baseUrl}}/queues/{{queueId}}/consumers
Content-Type: application/json

{
  "name": "{{consumerName}}",
  "phone": "{{consumerPhone}}"
}

> {%
  if (!response.body.id) {
    throw new Error("Consumer id missing");
    //console.log(response.body)
  }
  client.global.set("consumerId", response.body.id);
%}

### Get Consumer 1 by ID
# @name getConsumerById
GET {{baseUrl}}/consumers/{{consumerId}}


### Create WALK-IN Consumer 2 (Temporary)
# @name createWalkInConsumer2
POST {{baseUrl}}/queues/{{queueId}}/consumers
Content-Type: application/json

{
  "name": "{{consumerName}}",
  "phone": "{{consumerPhone}}"
}

> {%
  if (!response.body.id) {
    throw new Error("Consumer id missing");
    //console.log(response.body)
  }
  client.global.set("consumerId2", response.body.id);
%}

### Get Consumer 2 by ID
# @name getConsumer2ById
GET {{baseUrl}}/consumers/{{consumerId2}}

### List Consumers for Queue
# @name listConsumersByQueue
GET {{baseUrl}}/queues/{{queueId}}/consumers

> {%
  if (!Array.isArray(response.body)) {
    throw new Error("Expected array of consumers");
  }
%}

###############################################################################
# TOKENS
###############################################################################

### Issue Token #1
POST {{baseUrl}}/queues/{{queueId}}/token
Content-Type: application/json

{
  "consumerId": "{{consumerId}}"
}

> {%
  if (!response.body.id) {
    throw new Error("Token id missing");
  }
  client.global.set("tokenId1", response.body.id);
%}
### Issue Token #2
POST {{baseUrl}}/queues/{{queueId}}/token
Content-Type: application/json

{
  "consumerId": "{{consumerId2}}"
}
# > {%
#   if (!response.body.id) {
#     throw new Error("Token id missing");
#   }
#   client.global.set("tokenId2", response.body.id);
# %}
### Call Next Token
POST {{baseUrl}}/queues/{{queueId}}/next

> {%
  if (response.body.status !== "called") {
    throw new Error("Expected token to be called");
  }
%}